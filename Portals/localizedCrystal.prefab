      m_Calls: []
  m_text: "<align=center><b>The Quantum Crystal: <br>Neglected for 100 Years </b><br><br>Explore
    William Duane's 1923 quantum scattering model of crystal diffraction, which utilizes
    aspects of quantum physics neglected in interpretations relying on wave-particle
    duality.<br><br><i> \"a theory of the reflection of X-rays by crystals\u201A
    based on quantum ideas without reference to interference law\"</i></align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ddbcc27b0346e4644a45316aaf00c441, type: 2}
